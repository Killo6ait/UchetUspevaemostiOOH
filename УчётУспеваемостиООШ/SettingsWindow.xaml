<Window x:Class="УчётУспеваемостиООШ.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки программы" 
        Height="600" Width="500"
        WindowStartupLocation="CenterOwner" 
        ResizeMode="NoResize"
        Background="#f5f6fa">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Настройки программы" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- Тема -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="Тема:" Width="150" VerticalAlignment="Center"/>
            <ComboBox x:Name="cmbTheme" Width="150" SelectionChanged="cmbTheme_SelectionChanged">
                <ComboBoxItem Content="Светлая" Tag="Light"/>
                <ComboBoxItem Content="Тёмная" Tag="Dark"/>
            </ComboBox>
        </StackPanel>

        <!-- Масштаб -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="Масштаб:" Width="150" VerticalAlignment="Center"/>
            <ComboBox x:Name="cmbScale" Width="150" SelectionChanged="cmbScale_SelectionChanged">
                <ComboBoxItem Content="75%" Tag="75"/>
                <ComboBoxItem Content="100%" Tag="100"/>
                <ComboBoxItem Content="125%" Tag="125"/>
                <ComboBoxItem Content="150%" Tag="150"/>
            </ComboBox>
        </StackPanel>

        <!-- Шрифт -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="Шрифт:" Width="150" VerticalAlignment="Center"/>
            <ComboBox x:Name="cmbFont" Width="150" SelectionChanged="cmbFont_SelectionChanged">
                <ComboBoxItem Content="Arial" Tag="Arial"/>
                <ComboBoxItem Content="Times New Roman" Tag="Times New Roman"/>
                <ComboBoxItem Content="Calibri" Tag="Calibri"/>
                <ComboBoxItem Content="Verdana" Tag="Verdana"/>
                <ComboBoxItem Content="Segoe UI" Tag="Segoe UI"/>
            </ComboBox>
        </StackPanel>

        <Separator Grid.Row="4" Margin="0,15" Height="2" Background="#ecf0f1"/>

        <TextBlock Grid.Row="5" Text="Резервное копирование" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- Автобэкап -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="Автобэкап:" Width="150" VerticalAlignment="Center"/>
            <CheckBox x:Name="chkAutoBackup" VerticalAlignment="Center" Checked="chkAutoBackup_Changed" Unchecked="chkAutoBackup_Changed"/>
        </StackPanel>

        <!-- Интервал -->
        <StackPanel Grid.Row="7" Orientation="Horizontal" Margin="0,5">
            <TextBlock Text="Интервал (дней):" Width="150" VerticalAlignment="Center"/>
            <TextBox x:Name="txtBackupInterval" Width="100" TextChanged="txtBackupInterval_TextChanged"/>
        </StackPanel>

        <!-- Кнопки ручного управления -->
        <StackPanel Grid.Row="8" Orientation="Horizontal" Margin="0,15">
            <Button x:Name="btnCreateBackup" 
                    Content="Создать резервную копию" 
                    Width="180" Height="35"
                    Background="#3498db"
                    Foreground="White"
                    Margin="0,0,10,0"
                    Click="btnCreateBackup_Click"/>
            <Button x:Name="btnRestoreBackup" 
                    Content="Восстановить из копии" 
                    Width="180" Height="35"
                    Background="#f39c12"
                    Foreground="White"
                    Click="btnRestoreBackup_Click"/>
        </StackPanel>

        <Separator Grid.Row="9" Margin="0,15" Height="2" Background="#ecf0f1"/>

        <!-- Кнопки сохранения/отмены -->
        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="btnSave" Content="Сохранить" Width="100" Height="35" Background="#27ae60" Foreground="White" Click="btnSave_Click" Margin="0,0,15,0"/>
            <Button x:Name="btnCancel" Content="Отмена" Width="100" Height="35" Background="#95a5a6" Foreground="White" Click="btnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>