<Window x:Class="УчётУспеваемостиООШ.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизация - Учёт успеваемости" 
        Height="300" Width="400" 
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   Text="Вход в систему учёта успеваемости" 
                   FontSize="16" 
                   FontWeight="Bold" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20"/>

        <!-- Логин -->
        <StackPanel Grid.Row="1" Margin="0,5">
            <TextBlock Text="Логин:" Margin="0,0,0,5"/>
            <TextBox x:Name="txtUsername" Height="30" Padding="5"/>
        </StackPanel>

        <!-- Пароль -->
        <StackPanel Grid.Row="2" Margin="0,5">
            <TextBlock Text="Пароль:" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtPassword" Height="30" Padding="5"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20">
            <Button x:Name="btnLogin" 
                    Content="Войти" 
                    Width="100" Height="35" 
                    Margin="0,0,10,0"
                    Click="btnLogin_Click"/>
            <Button x:Name="btnCancel" 
                    Content="Отмена" 
                    Width="100" Height="35" 
                    Click="btnCancel_Click"/>
        </StackPanel>

        <!-- Сообщение об ошибке -->
        <TextBlock x:Name="txtErrorMessage" 
                   Grid.Row="4" 
                   Foreground="Red" 
                   HorizontalAlignment="Center" 
                   TextWrapping="Wrap"
                   Visibility="Collapsed"/>
    </Grid>
</Window>