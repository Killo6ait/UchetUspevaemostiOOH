<Window x:Class="УчётУспеваемостиООШ.GradesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:УчётУспеваемостиООШ"
        mc:Ignorable="d"
        Title="Управление оценками" 
        Height="1005" Width="1206"
        WindowStartupLocation="CenterScreen"
        Background="#f5f6fa">

    <Window.Resources>

        <DropShadowEffect x:Key="ButtonShadow" 
                          Color="Black" 
                          Direction="315" 
                          ShadowDepth="5" 
                          Opacity="0.3" 
                          BlurRadius="10"/>


        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="5"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Style.Resources>
        </Style>


        <Style x:Key="FormFieldStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#34495e"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>

        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

   
        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>


        <Style x:Key="DatePickerStyle" TargetType="DatePicker">
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <Border Grid.Row="0" 
                Background="#2c3e50" 
                Padding="15" 
                CornerRadius="10"
                Margin="0,0,0,15">
            <TextBlock Text="Управление оценками" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="White"
                       HorizontalAlignment="Center"/>
        </Border>

        <Border Grid.Row="1" 
                Background="White" 
                CornerRadius="10" 
                Padding="15"
                Margin="0,0,0,15"
                Effect="{StaticResource ButtonShadow}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
    
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="Класс:" 
                               VerticalAlignment="Center" 
                               FontSize="14" 
                               FontWeight="SemiBold"
                               Margin="0,0,10,0"/>
                    <ComboBox x:Name="cmbClassForExport" 
                              Width="100" 
                              Height="35"
                              FontSize="14"
                              SelectionChanged="cmbClassForExport_SelectionChanged"/>
                </StackPanel>

                <Button x:Name="btnCharts" 
                        Content="📊 Графики" 
                        Width="120" Height="35"
                        Background="#3498db"
                        Foreground="White"
                        FontSize="14"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Margin="5"
                        Cursor="Hand"
                        Click="btnCharts_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

  
                <Button x:Name="btnExport" 
                        Content="📥 Экспорт" 
                        Width="120" Height="35"
                        Background="#27ae60"
                        Foreground="White"
                        FontSize="14"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Margin="5"
                        Cursor="Hand"
                        Click="btnExport_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>


        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>


            <Border Grid.Column="0" 
                    Background="White" 
                    CornerRadius="10" 
                    Padding="10"
                    Margin="0,0,10,0"
                    Effect="{StaticResource ButtonShadow}">
                <DataGrid x:Name="dgGrades" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          RowHeight="35"
                          FontSize="13"
                          BorderThickness="0"
                          Background="White"
                          RowHeaderWidth="0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#ecf0f1"
                          SelectionChanged="dgGrades_SelectionChanged"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">

                    <DataGrid.Columns>
         
                        <DataGridTextColumn Header="ID" 
                                            Binding="{Binding GradeID}" 
                                            Width="50"
                                            Visibility="Collapsed"/>

     
                        <DataGridTextColumn Header="Ученик" 
                                            Binding="{Binding StudentFullName}" 
                                            Width="200"/>

          
                        <DataGridTextColumn Header="Класс" 
                                            Binding="{Binding ClassName}" 
                                            Width="80"/>

 
                        <DataGridTextColumn Header="Предмет" 
                                            Binding="{Binding SubjectName}" 
                                            Width="150"/>


                        <DataGridTextColumn Header="Оценка" 
                                            Binding="{Binding GradeValue}" 
                                            Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

   
                        <DataGridTextColumn Header="Дата" 
                                            Binding="{Binding GradeDate, StringFormat='dd.MM.yyyy'}" 
                                            Width="100"/>

   
                        <DataGridTextColumn Header="Тип работы" 
                                            Binding="{Binding ControlType}" 
                                            Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
     
            <GridSplitter Grid.Column="1" 
                          Width="5" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Stretch"
                          Background="Transparent"/>


            <ScrollViewer Grid.Column="2" 
                          VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Disabled">
                <Border Background="White" 
                        CornerRadius="10" 
                        Padding="20"
                        Margin="0,0,0,0"
                        Effect="{StaticResource ButtonShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

    
                        <TextBlock Grid.Row="0" 
                                   Text="Данные оценки" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   Foreground="#2c3e50"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,15"/>


                        <TextBlock Grid.Row="1" Style="{StaticResource FormFieldStyle}" Text="ID:"/>
                        <TextBox x:Name="txtGradeID" 
                                 Grid.Row="2" 
                                 Style="{StaticResource TextBoxStyle}"
                                 IsReadOnly="True"
                                 Background="#ecf0f1"/>

           
                        <TextBlock Grid.Row="3" Style="{StaticResource FormFieldStyle}" Text="Ученик:"/>
                        <ComboBox x:Name="cmbStudent" 
                                  Grid.Row="4" 
                                  Style="{StaticResource ComboBoxStyle}"
                                  DisplayMemberPath="FullName"
                                  SelectedValuePath="StudentID"/>

      
                        <TextBlock Grid.Row="5" Style="{StaticResource FormFieldStyle}" Text="Предмет:"/>
                        <ComboBox x:Name="cmbSubject" 
                                  Grid.Row="6" 
                                  Style="{StaticResource ComboBoxStyle}"
                                  DisplayMemberPath="SubjectName"
                                  SelectedValuePath="SubjectID"/>


                        <TextBlock Grid.Row="7" Style="{StaticResource FormFieldStyle}" Text="Оценка:"/>
                        <ComboBox x:Name="cmbGrade" 
                                  Grid.Row="8" 
                                  Style="{StaticResource ComboBoxStyle}">
                            <ComboBoxItem Content="2"/>
                            <ComboBoxItem Content="3"/>
                            <ComboBoxItem Content="4"/>
                            <ComboBoxItem Content="5"/>
                        </ComboBox>


                        <TextBlock Grid.Row="9" Style="{StaticResource FormFieldStyle}" Text="Дата:"/>
                        <DatePicker x:Name="dpDate" 
                                    Grid.Row="10" 
                                    Style="{StaticResource DatePickerStyle}"/>


                        <TextBlock Grid.Row="11" Style="{StaticResource FormFieldStyle}" Text="Тип работы:"/>
                        <ComboBox x:Name="cmbControlType" 
                                  Grid.Row="12" 
                                  Style="{StaticResource ComboBoxStyle}">
                            <ComboBoxItem Content="Контрольная работа"/>
                            <ComboBoxItem Content="Самостоятельная работа"/>
                            <ComboBoxItem Content="Лабораторная работа"/>
                            <ComboBoxItem Content="Ответ у доски"/>
                            <ComboBoxItem Content="Тест"/>
                            <ComboBoxItem Content="Диктант"/>
                            <ComboBoxItem Content="Сочинение"/>
                            <ComboBoxItem Content="Изложение"/>
                        </ComboBox>
                 
                        <WrapPanel Grid.Row="13" 
                                   Orientation="Horizontal" 
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,0">
                            <Button x:Name="btnAdd" 
                                    Content="➕ Добавить" 
                                    Style="{StaticResource ActionButtonStyle}"
                                    Background="#3498db"
                                    Click="btnAdd_Click"/>
                            <Button x:Name="btnUpdate" 
                                    Content="✏️ Сохранить" 
                                    Style="{StaticResource ActionButtonStyle}"
                                    Background="#f39c12"
                                    Click="btnUpdate_Click"/>
                            <Button x:Name="btnDelete" 
                                    Content="🗑️ Удалить" 
                                    Style="{StaticResource ActionButtonStyle}"
                                    Background="#e74c3c"
                                    Click="btnDelete_Click"/>
                            <Button x:Name="btnClear" 
                                    Content="🔄 Очистить" 
                                    Style="{StaticResource ActionButtonStyle}"
                                    Background="#95a5a6"
                                    Click="btnClear_Click"/>
                        </WrapPanel>

                       
                    </Grid>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>