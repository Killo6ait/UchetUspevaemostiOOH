<Window x:Class="УчётУспеваемостиООШ.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Поиск учащихся" Height="319" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Введите критерии поиска" 
                   FontSize="16" FontWeight="Bold" Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1" Text="Фамилия:"/>
        <TextBox x:Name="txtLastName" Grid.Row="2" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="3" Text="Имя:"/>
        <TextBox x:Name="txtFirstName" Grid.Row="4" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="5" Text="Класс:"/>
        <ComboBox x:Name="cmbClass" Grid.Row="6" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button x:Name="btnSearch" Content="Найти" Width="100" Height="35" 
                    Margin="0,0,10,0" Click="btnSearch_Click" Background="#3498db" Foreground="White"/>
            <Button x:Name="btnCancel" Content="Отмена" Width="100" Height="35" 
                    Click="btnCancel_Click" Background="#95a5a6" Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>