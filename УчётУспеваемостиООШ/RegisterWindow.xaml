<Window x:Class="УчётУспеваемостиООШ.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация"
        Height="459"
        Width="387"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#f5f6fa">

    <Grid Margin="25">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0"
                   Text="Регистрация"
                   FontSize="22"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <!-- Логин -->
        <TextBlock Grid.Row="1" Text="Логин"/>
        <TextBox x:Name="txtUsername"
                 Grid.Row="2"
                 Height="35"
                 Margin="0,5,0,10"
                 Padding="5"/>

        <!-- Пароль -->
        <TextBlock Grid.Row="3" Text="Пароль"/>
        <PasswordBox x:Name="txtPassword"
                     Grid.Row="4"
                     Height="35"
                     Margin="0,5,0,10"
                     Padding="5"/>

        <!-- Подтверждение -->
        <TextBlock Grid.Row="5" Text="Подтверждение пароля"/>
        <PasswordBox x:Name="txtConfirmPassword"
                     Grid.Row="6"
                     Height="35"
                     Margin="0,5,0,10"
                     Padding="5"/>

        <!-- Роль -->
        <TextBlock Grid.Row="7" Text="Роль"/>
        <ComboBox x:Name="cmbRole"
                  Grid.Row="8"
                  Height="35"
                  Margin="0,5,0,15"
                  SelectedIndex="0">
            <ComboBoxItem Content="Учитель" Tag="Учитель"/>
            <ComboBoxItem Content="Директор" Tag="Директор"/>
        </ComboBox>

        <!-- Кнопки -->
        <StackPanel Grid.Row="9"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0">

            <Button x:Name="btnRegister"
                    Content="Зарегистрироваться"
                    Width="160"
                    Height="35"
                    Background="#27ae60"
                    Foreground="White"
                    Margin="0,0,10,0"
                    Click="btnRegister_Click"/>

            <Button x:Name="btnCancel"
                    Content="Отмена"
                    Width="100"
                    Height="35"
                    Background="#95a5a6"
                    Foreground="White"
                    Click="btnCancel_Click"/>

        </StackPanel>

        <!-- Ошибка -->
        <TextBlock x:Name="txtError"
                   Grid.Row="10"
                   Foreground="Red"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,15,0,0"
                   Visibility="Collapsed"/>

    </Grid>
</Window>