<Window x:Class="УчётУспеваемостиООШ.ChartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        Title="Визуализация успеваемости" Height="600" Width="900"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="1">

            <TabItem Header="Средний балл по классам">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="257*"/>
                        <ColumnDefinition Width="597*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <StackPanel Grid.Row="0" 
                                Orientation="Horizontal" 
                                HorizontalAlignment="Left"
                                Margin="90,10,0,10" Grid.Column="1">
                        <TextBlock Text="Класс:" 
                                   VerticalAlignment="Center" 
                                   FontSize="14" 
                                   FontWeight="SemiBold"
                                   Margin="0,0,10,0"/>
                        <ComboBox x:Name="cmbClassForChart" 
                                  Width="100" 
                                  Height="30"
                                  FontSize="14"
                                  Margin="0,0,10,0"
                                  SelectionChanged="cmbClassForChart_SelectionChanged"/>
                    </StackPanel>

                    <lvc:CartesianChart x:Name="ClassAverageChart" 
                                        Grid.Row="1"
                                        Series="{Binding ClassAverageSeries}"
                                        LegendLocation="Right" Grid.ColumnSpan="2">
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Title="Классы" Labels="{Binding ClassNames}"/>
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis Title="Средний балл" MinValue="2" MaxValue="5"/>
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </Grid>
            </TabItem>


            <TabItem Header="Динамика успеваемости">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="71*"/>
                        <ColumnDefinition Width="34*"/>
                        <ColumnDefinition Width="749*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10" Grid.ColumnSpan="3">
                        <TextBlock Text="Ученик:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox x:Name="cmbStudent" Width="200" Margin="0,0,10,0"/>
                        <TextBlock Text="Предмет:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox x:Name="cmbSubject" Width="200" Margin="0,0,10,0"/>
                        <Button x:Name="btnShowProgress" Content="Показать" 
                                Width="100" Click="btnShowProgress_Click"/>
                    </StackPanel>

                    <lvc:CartesianChart x:Name="ProgressChart" Grid.Row="1"
                                        Series="{Binding ProgressSeries}"
                                        LegendLocation="Right" Grid.ColumnSpan="3">
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Title="Дата"/>
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis Title="Оценка" MinValue="2" MaxValue="5"/>
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>