<Window x:Class="УчётУспеваемостиООШ.StudentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:УчётУспеваемостиООШ"
        mc:Ignorable="d"
        Title="Управление учащимися" 
        Height="1014" Width="1206"
        WindowStartupLocation="CenterScreen"
        Background="#f5f6fa">

    <Window.Resources>
        <!-- Эффект тени для кнопок -->
        <DropShadowEffect x:Key="ButtonShadow" 
                          Color="Black" 
                          Direction="315" 
                          ShadowDepth="5" 
                          Opacity="0.3" 
                          BlurRadius="10"/>

        <!-- Стиль для кнопок -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="5"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Style.Resources>
        </Style>

        <!-- Стиль для текстовых полей (заголовки) -->
        <Style x:Key="FormFieldStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#34495e"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>

        <!-- Стиль для ComboBox -->
        <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Стиль для TextBox -->
        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5,0"/>
        </Style>

        <!-- Стиль для DatePicker -->
        <Style x:Key="DatePickerStyle" TargetType="DatePicker">
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" 
                Background="#2c3e50" 
                Padding="15" 
                CornerRadius="10"
                Margin="0,0,0,15">
            <TextBlock Text="Управление учащимися" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="White"
                       HorizontalAlignment="Center"/>
        </Border>

       

        <!-- Основная область -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- DataGrid с учащимися -->
            <Border Grid.Column="0" 
                    Background="White" 
                    CornerRadius="10" 
                    Padding="10"
                    Margin="0,0,10,0"
                    Effect="{StaticResource ButtonShadow}">
                <DataGrid x:Name="dgStudents" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          RowHeight="35"
                          FontSize="13"
                          BorderThickness="0"
                          Background="White"
                          RowHeaderWidth="0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#ecf0f1"
                          SelectionChanged="dgStudents_SelectionChanged"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">

                    <DataGrid.Columns>
                        <!-- ID (скрытая колонка) -->
                        <DataGridTextColumn Header="ID" 
                                            Binding="{Binding StudentID}" 
                                            Width="50"
                                            Visibility="Collapsed"/>

                        <!-- Фамилия -->
                        <DataGridTextColumn Header="Фамилия" 
                                            Binding="{Binding LastName}" 
                                            Width="120"/>

                        <!-- Имя -->
                        <DataGridTextColumn Header="Имя" 
                                            Binding="{Binding FirstName}" 
                                            Width="120"/>

                        <!-- Отчество -->
                        <DataGridTextColumn Header="Отчество" 
                                            Binding="{Binding MiddleName}" 
                                            Width="120"/>

                        <!-- Класс -->
                        <DataGridTextColumn Header="Класс" 
                                            Binding="{Binding ClassName}" 
                                            Width="80"/>

                        <!-- Дата рождения -->
                        <DataGridTextColumn Header="Дата рождения" 
                                            Binding="{Binding BirthDate, StringFormat='dd.MM.yyyy'}" 
                                            Width="120"/>

                        <!-- Адрес родителей -->
                        <DataGridTextColumn Header="Адрес родителей" 
                                            Binding="{Binding ParentAddress}" 
                                            Width="250"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Разделитель -->
            <GridSplitter Grid.Column="1" 
                          Width="5" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Stretch"
                          Background="Transparent"/>

            <!-- Панель ввода данных -->
            <ScrollViewer Grid.Column="2" 
                          VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Disabled">
                <Border Background="White" 
                        CornerRadius="10" 
                        Padding="20"
                        Margin="0,0,0,0"
                        Effect="{StaticResource ButtonShadow}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Заголовок формы -->
                        <TextBlock Grid.Row="0" 
                                   Text="Данные учащегося" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   Foreground="#2c3e50"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,15"/>

                        <!-- ID (скрытое поле) -->
                        <TextBlock Grid.Row="1" Style="{StaticResource FormFieldStyle}" Text="ID:"/>
                        <TextBox x:Name="txtStudentID" 
                                 Grid.Row="2" 
                                 Style="{StaticResource TextBoxStyle}"
                                 IsReadOnly="True"
                                 Background="#ecf0f1"/>

                        <!-- Фамилия -->
                        <TextBlock Grid.Row="3" Style="{StaticResource FormFieldStyle}" Text="Фамилия:"/>
                        <TextBox x:Name="txtLastName" 
                                 Grid.Row="4" 
                                 Style="{StaticResource TextBoxStyle}"/>

                        <!-- Имя -->
                        <TextBlock Grid.Row="5" Style="{StaticResource FormFieldStyle}" Text="Имя:"/>
                        <TextBox x:Name="txtFirstName" 
                                 Grid.Row="6" 
                                 Style="{StaticResource TextBoxStyle}"/>

                        <!-- Отчество -->
                        <TextBlock Grid.Row="7" Style="{StaticResource FormFieldStyle}" Text="Отчество:"/>
                        <TextBox x:Name="txtMiddleName" 
                                 Grid.Row="8" 
                                 Style="{StaticResource TextBoxStyle}"/>

                        <!-- Класс (ComboBox) -->
                        <TextBlock Grid.Row="9" Style="{StaticResource FormFieldStyle}" Text="Класс:"/>
                        <ComboBox x:Name="cmbClass" 
                                  Grid.Row="10" 
                                  Style="{StaticResource ComboBoxStyle}"
                                  DisplayMemberPath="ClassName"
                                  SelectedValuePath="ClassID"/>

                        <!-- Дата рождения (DatePicker) -->
                        <TextBlock Grid.Row="11" Style="{StaticResource FormFieldStyle}" Text="Дата рождения:"/>
                        <DatePicker x:Name="dpBirthDate" 
                                    Grid.Row="12" 
                                    Style="{StaticResource DatePickerStyle}"/>

                        <!-- Адрес родителей -->
                        <TextBlock Grid.Row="13" Style="{StaticResource FormFieldStyle}" Text="Адрес родителей:"/>
                        <TextBox x:Name="txtParentAddress" 
                                 Grid.Row="14" 
                                 Style="{StaticResource TextBoxStyle}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Height="60"/>

                        <!-- Кнопки действий -->
                        <WrapPanel Grid.Row="15" 
                                   Orientation="Horizontal" 
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,0">
                            <Button x:Name="btnAdd" 
                                    Content="➕ Добавить" 
                                    Style="{StaticResource ActionButtonStyle}"
                                    Background="#3498db"
                                    Click="btnAdd_Click"/>
                            <Button x:Name="btnUpdate" 
                                    Content="✏️ Сохранить" 
                                    Style="{StaticResource ActionButtonStyle}"
                                    Background="#f39c12"
                                    Click="btnUpdate_Click"/>
                            <Button x:Name="btnDelete" 
                                    Content="🗑️ Удалить" 
                                    Style="{StaticResource ActionButtonStyle}"
                                    Background="#e74c3c"
                                    Click="btnDelete_Click"/>
                            <Button x:Name="btnClear" 
                                    Content="🔄 Очистить" 
                                    Style="{StaticResource ActionButtonStyle}"
                                    Background="#95a5a6"
                                    Click="btnClear_Click"/>
                            <Button x:Name="btnSearch" 
                             Content="🔍 Поиск учащихся" 
                             Width="250" Height="45"
                             Background="#3498db"
                             Style="{StaticResource ActionButtonStyle}"
                             FontWeight="Bold"
                             Click="btnSearch_Click">
                            </Button>
                            <Button x:Name="btnResetFilter" 
                             Content="🔄 Сбросить фильтр" 
                             Width="250" Height="45"
                             Background="#95a5a6"
                             Style="{StaticResource ActionButtonStyle}"
                             FontWeight="Bold"
                             Click="btnResetFilter_Click">
                            </Button>
                        </WrapPanel>
                    </Grid>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>