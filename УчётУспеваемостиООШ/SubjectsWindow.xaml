<local:BaseWindow x:Class="УчётУспеваемостиООШ.SubjectsWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:local="clr-namespace:УчётУспеваемостиООШ"
                  mc:Ignorable="d"
                  Title="Управление предметами" 
                  Width="1206"
                  WindowStartupLocation="CenterScreen"
                  WindowState="Maximized"
                  Background="{DynamicResource WindowBackground}">

    <local:BaseWindow.Resources>
        <!-- Эффект тени для кнопок -->
        <DropShadowEffect x:Key="ButtonShadow" 
                          Color="Black" 
                          Direction="315" 
                          ShadowDepth="5" 
                          Opacity="0.3" 
                          BlurRadius="10"/>

        <!-- Стиль для кнопок действий -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="5"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Style.Resources>
        </Style>

        <!-- Стиль для текстовых полей (заголовки) -->
        <Style x:Key="FormFieldStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Margin" Value="0,10,0,5"/>
        </Style>

        <!-- Стиль для ID поля (только для чтения) -->
        <Style x:Key="IdTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5,0"/>
            <Setter Property="Background" Value="{DynamicResource DataGridHeaderColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>
    </local:BaseWindow.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" 
                Background="#2c3e50" 
                Padding="15" 
                CornerRadius="10"
                Margin="0,0,0,15">
            <TextBlock Text="Управление предметами" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="White"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Основная область -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- DataGrid с предметами -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource ControlBackground}" 
                    CornerRadius="10" 
                    Padding="10"
                    Margin="0,0,10,0"
                    Effect="{StaticResource ButtonShadow}">
                <DataGrid x:Name="dgSubjects" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          RowHeight="35"
                          FontSize="13"
                          BorderThickness="0"
                          Background="{DynamicResource ControlBackground}"
                          Foreground="{DynamicResource TextColor}"
                          RowHeaderWidth="0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource BorderColor}"
                          SelectionChanged="dgSubjects_SelectionChanged"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">

                    <DataGrid.Columns>
                        <!-- ID (скрытая колонка) -->
                        <DataGridTextColumn Header="ID" 
                                            Binding="{Binding SubjectID}" 
                                            Width="50"
                                            Visibility="Collapsed"/>

                        <!-- Название предмета -->
                        <DataGridTextColumn Header="Название предмета" 
                                            Binding="{Binding SubjectName}" 
                                            Width="250"/>

                        <!-- Учитель -->
                        <DataGridTextColumn Header="Учитель" 
                                            Binding="{Binding TeacherName}" 
                                            Width="250"/>

                        <!-- Часов в неделю -->
                        <DataGridTextColumn Header="Часов в неделю" 
                                            Binding="{Binding HoursPerWeek}" 
                                            Width="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Разделитель -->
            <GridSplitter Grid.Column="1" 
                          Width="5" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Stretch"
                          Background="Transparent"/>

            <!-- Панель ввода данных -->
            <ScrollViewer Grid.Column="2" 
                          VerticalScrollBarVisibility="Auto" 
                          HorizontalScrollBarVisibility="Disabled">
                <Border Background="{DynamicResource ControlBackground}" 
                        CornerRadius="10" 
                        Padding="20"
                        Margin="0,0,0,0"
                        Effect="{StaticResource ButtonShadow}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Заголовок формы -->
                        <TextBlock Grid.Row="0" 
                                   Text="Данные предмета" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource TextColor}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,15"/>

                        <!-- ID (скрытое поле) -->
                        <TextBlock Grid.Row="1" Style="{StaticResource FormFieldStyle}" Text="ID:"/>
                        <TextBox x:Name="txtSubjectID" 
                                 Grid.Row="2" 
                                 Style="{StaticResource IdTextBoxStyle}"/>

                        <!-- Название предмета (белое) -->
                        <TextBlock Grid.Row="3" Style="{StaticResource FormFieldStyle}" Text="Название предмета:"/>
                        <TextBox x:Name="txtSubjectName" 
                                 Grid.Row="4" 
                                 Height="35" 
                                 FontSize="14" 
                                 Margin="0,0,0,10" 
                                 Padding="5,0" 
                                 VerticalContentAlignment="Center"/>

                        <!-- Учитель (ComboBox белый) -->
                        <TextBlock Grid.Row="5" Style="{StaticResource FormFieldStyle}" Text="Учитель:"/>
                        <ComboBox x:Name="cmbTeacher" 
                                  Grid.Row="6" 
                                  Height="35" 
                                  FontSize="14" 
                                  Margin="0,0,0,10"
                                  DisplayMemberPath="FullName"
                                  SelectedValuePath="TeacherID"/>

                        <!-- Часов в неделю (ComboBox белый) -->
                        <TextBlock Grid.Row="7" Style="{StaticResource FormFieldStyle}" Text="Часов в неделю:"/>
                        <ComboBox x:Name="cmbHoursPerWeek" 
                                  Grid.Row="8" 
                                  Height="35" 
                                  FontSize="14" 
                                  Margin="0,0,0,10"
                                  SelectedIndex="2">
                            <ComboBoxItem Content="1 час" Tag="1"/>
                            <ComboBoxItem Content="2 часа" Tag="2"/>
                            <ComboBoxItem Content="3 часа" Tag="3"/>
                            <ComboBoxItem Content="4 часа" Tag="4"/>
                            <ComboBoxItem Content="5 часов" Tag="5"/>
                            <ComboBoxItem Content="6 часов" Tag="6"/>
                        </ComboBox>

                        <!-- Кнопки действий -->
                        <WrapPanel Grid.Row="9" 
                                   Orientation="Horizontal" 
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,0">
                            <Button x:Name="btnAdd" 
                                    Content="➕ Добавить" 
                                    Style="{StaticResource ActionButtonStyle}"
                                    Background="#3498db"
                                    Click="btnAdd_Click"/>
                            <Button x:Name="btnUpdate" 
                                    Content="✏️ Сохранить" 
                                    Style="{StaticResource ActionButtonStyle}"
                                    Background="#f39c12"
                                    Click="btnUpdate_Click"/>
                            <Button x:Name="btnDelete" 
                                    Content="🗑️ Удалить" 
                                    Style="{StaticResource ActionButtonStyle}"
                                    Background="#e74c3c"
                                    Click="btnDelete_Click"/>
                            <Button x:Name="btnClear" 
                                    Content="🔄 Очистить" 
                                    Style="{StaticResource ActionButtonStyle}"
                                    Background="#95a5a6"
                                    Click="btnClear_Click"/>
                        </WrapPanel>
                    </Grid>
                </Border>
            </ScrollViewer>
        </Grid>
    </Grid>
</local:BaseWindow>