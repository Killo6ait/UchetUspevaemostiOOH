<local:BaseWindow x:Class="УчётУспеваемостиООШ.Menu"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:local="clr-namespace:УчётУспеваемостиООШ"
                  mc:Ignorable="d"
                  Title="Главное меню - Учёт успеваемости" 
                  Height="824" Width="1000"
                  WindowStartupLocation="CenterScreen"
                  WindowState="Maximized"
                  Background="{DynamicResource WindowBackground}">

    <local:BaseWindow.Resources>
        <DropShadowEffect x:Key="ButtonShadow" 
                          Color="Black" 
                          Direction="315" 
                          ShadowDepth="5" 
                          Opacity="0.3" 
                          BlurRadius="10"/>

        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="220"/>
            <Setter Property="Height" Value="220"/>
            <Setter Property="Margin" Value="15"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="15"
                                Padding="10"
                                BorderBrush="#bdc3c7"
                                BorderThickness="1"
                                Effect="{StaticResource ButtonShadow}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="icon" 
                                           Grid.Row="0"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="48"
                                           Text="{TemplateBinding Tag}"
                                           HorizontalAlignment="Center"
                                           Margin="0,20,0,10"/>

                                <TextBlock x:Name="text" 
                                           Grid.Row="1"
                                           Text="{TemplateBinding Content}"
                                           FontSize="18"
                                           FontWeight="Normal"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="10"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="130"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#7f8c8d"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#95a5a6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </local:BaseWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2c3e50" Padding="20" CornerRadius="0,0,20,20" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="🏫" FontSize="32" Margin="0,0,15,0"/>
                    <StackPanel>
                        <TextBlock Text="МБОУ 2-Пристанская ООШ" FontSize="24" FontWeight="Bold" Foreground="White"/>
                        <TextBlock x:Name="txtUserInfo" Text="Пользователь: Загрузка..." FontSize="14" Foreground="#bdc3c7"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnSettings" 
                            Content="⚙️ Настройки" 
                            Style="{StaticResource TopBarButtonStyle}"
                            Click="btnSettings_Click"
                            Margin="0,0,15,0"/>

                    <Button x:Name="btnLogout" 
                            Content="Выход" 
                            Width="100" 
                            Height="40"
                            Background="#e74c3c"
                            Foreground="White"
                            FontSize="14"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Click="btnLogout_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="30,0,30,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                           Text="Выберите раздел для работы" 
                           FontSize="28" 
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextColor}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30"/>

                <Grid Grid.Row="1" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource MenuButtonStyle}" Background="#3498db" Tag="&#xE716;" Content="Учащиеся" x:Name="btnStudents" Click="btnStudents_Click"/>
                    <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource MenuButtonStyle}" Background="#f39c12" Tag="&#xE7C1;" Content="Предметы" x:Name="btnSubjects" Click="btnSubjects_Click"/>
                    <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource MenuButtonStyle}" Background="#e74c3c" Tag="&#xE9D2;" Content="Оценки" x:Name="btnGrades" Click="btnGrades_Click"/>
                    <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource MenuButtonStyle}" Background="#9b59b6" Tag="&#xE8F1;" Content="Посещаемость" x:Name="btnAttendance" Click="btnAttendance_Click"/>
                </Grid>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#ecf0f1" Padding="20" CornerRadius="20,20,0,0" Margin="0,20,0,0">
            <TextBlock x:Name="txtStatus" Text="Готов к работе. Выберите раздел." Foreground="#7f8c8d" FontSize="14"/>
        </Border>
    </Grid>
</local:BaseWindow>