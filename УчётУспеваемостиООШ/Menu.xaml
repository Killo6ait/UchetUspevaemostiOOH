<Window x:Class="УчётУспеваемостиООШ.Menu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:УчётУспеваемостиООШ"
        mc:Ignorable="d"
        Title="Главное меню - Учёт успеваемости" 
        Height="824" Width="1000"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#f5f6fa">

    <Window.Resources>
        <!-- Эффект тени для кнопок - определен здесь -->
        <DropShadowEffect x:Key="ButtonShadow" 
                          Color="Black" 
                          Direction="315" 
                          ShadowDepth="5" 
                          Opacity="0.3" 
                          BlurRadius="10"/>

        <!-- Стиль для кнопок меню (без конвертера) -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="220"/>
            <Setter Property="Height" Value="220"/>
            <Setter Property="Margin" Value="15"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                CornerRadius="15"
                                Padding="10"
                                BorderBrush="#bdc3c7"
                                BorderThickness="1"
                                Effect="{StaticResource ButtonShadow}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Иконка -->
                                <TextBlock x:Name="icon" 
                                           Grid.Row="0"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="48"
                                           Text="{TemplateBinding Tag}"
                                           HorizontalAlignment="Center"
                                           Margin="0,20,0,10"/>

                                <!-- Текст кнопки -->
                                <TextBlock x:Name="text" 
                                           Grid.Row="1"
                                           Text="{TemplateBinding Content}"
                                           FontSize="18"
                                           FontWeight="Normal"
                                           TextWrapping="Wrap"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="10"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <!-- Простое осветление фона без конвертера -->
                                <Setter TargetName="border" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Background}"/>
                                <!-- Добавляем наложение полупрозрачного белого для эффекта осветления -->
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="border" Property="RenderTransformOrigin" Value="0.5,0.5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель с информацией о пользователе -->
        <Border Grid.Row="0" 
                Background="#2c3e50" 
                Padding="20" 
                CornerRadius="0,0,20,20"
                Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Заголовок -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="🏫" FontSize="32" Margin="0,0,15,0"/>
                    <StackPanel>
                        <TextBlock Text="МБОУ 2-Пристанская ООШ" 
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   Foreground="White"/>
                        <TextBlock x:Name="txtUserInfo" 
                                   Text="Пользователь: Загрузка..." 
                                   FontSize="14" 
                                   Foreground="#bdc3c7"/>
                    </StackPanel>
                </StackPanel>

                <!-- Кнопка выхода -->
                <Button x:Name="btnLogout" 
                        Grid.Column="1"
                        Content="Выход" 
                        Click="btnLogout_Click"
                        Width="100" 
                        Height="40"
                        Background="#e74c3c"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="14"
                        FontWeight="Bold"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- Основное меню с кнопками таблиц -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="30,0,30,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок раздела -->
                <TextBlock Grid.Row="0" 
                           Text="Выберите раздел для работы" 
                           FontSize="28" 
                           FontWeight="SemiBold"
                           Foreground="#34495e"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,30"/>

                <!-- Сетка с кнопками 2x2 -->
                <Grid Grid.Row="1" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Кнопка Учащиеся (синяя) -->
                    <Button Grid.Row="0" 
                            Grid.Column="0"
                            Style="{StaticResource MenuButtonStyle}"
                            Background="#3498db"
                            Tag="&#xE716;"
                            Content="Учащиеся"
                            x:Name="btnStudents"
                            Click="btnStudents_Click"/>

                    <!-- Кнопка Учителя (зеленая) -->

                    <!-- Кнопка Предметы (оранжевая) -->
                    <Button Grid.Row="1" 
                            Grid.Column="0"
                            Style="{StaticResource MenuButtonStyle}"
                            Background="#f39c12"
                            Tag="&#xE7C1;"
                            Content="Предметы"
                            x:Name="btnSubjects"
                            Click="btnSubjects_Click"/>

                    <!-- Кнопка Оценки (красная) -->
                    <Button Grid.Row="1" 
                            Grid.Column="1"
                            Style="{StaticResource MenuButtonStyle}"
                            Background="#e74c3c"
                            Tag="&#xE9D2;"
                            Content="Оценки"
                            x:Name="btnGrades"
                            Click="btnGrades_Click"/>

                    <Button 
                            Grid.Column="1"
                         Style="{StaticResource MenuButtonStyle}"
                         Background="#9b59b6"
                         Tag="&#xE8F1;"
                         Content="Посещаемость"
                         x:Name="btnAttendance"
                         Click="btnAttendance_Click" Margin="15,15,15,15"/>
                </Grid>

                <!-- Дополнительная строка с кнопками -->
                <Grid Grid.Row="2" HorizontalAlignment="Center" Margin="0,30,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Кнопка Посещаемость (фиолетовая) -->



                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- Нижняя панель -->
        <Border Grid.Row="2" 
                Background="#ecf0f1" 
                Padding="20" 
                CornerRadius="20,20,0,0"
                Margin="0,20,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           x:Name="txtStatus"
                           Text="Готов к работе. Выберите раздел." 
                           Foreground="#7f8c8d"
                           FontSize="14"/>


            </Grid>
        </Border>
    </Grid>
</Window>